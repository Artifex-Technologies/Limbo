# Maintainer: Artifex Technologies (https://github.com/Artifex-Technologies)
#
# Limbo ships as a small package of its own (two binaries, units, docs). /usr/bin/limbo is limbo-rs, the Rust build:
# it is the daemon (`limbo serve`, limbo.service) and hands every other command, unchanged, to the Go build at
# /usr/lib/limbo/limbo-go (docs/RUST_PORT.md), until each command is ported.
# Its heavy runtime (libvirt, QEMU, dnsmasq, ...) is deliberately NOT in
# depends=(): an image can carry Limbo "packaged and ready" without every system
# also carrying a hypervisor stack it may never use. `sudo limbo setup` installs
# the runtime on first use; `limbo doctor` says what is missing. The list below
# must match internal/deps (a test pins that they agree).
pkgname=limbo-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Limbo -- run Windows and Linux guest apps as sandboxed host windows, with quarantine and validation runs"
arch=('x86_64')
url="https://github.com/Artifex-Technologies/Limbo"
license=('MPL-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('go' 'git' 'rust')
optdepends=(
	'libvirt: manages guests (installed by `limbo setup`)'
	'qemu-base: the hypervisor (installed by `limbo setup`)'
	'dnsmasq: DHCP/DNS on each guest network (installed by `limbo setup`)'
	'nftables: each guest firewall (installed by `limbo setup`)'
	'openssh: validation runs (installed by `limbo setup`)'
	'libisoburn: builds the cloud-init seed disk (installed by `limbo setup`)'
	'waypipe: seamless windows for Linux guests'
	'freerdp: seamless windows for Windows guests (RemoteApp)'
	'bubblewrap: the sandbox of the Wine backend (limbo wine refuses to run without it)'
	'wine: Windows programs on the desktop through limbo wine (or wine-staging)'
)
provides=('limbo')
conflicts=('limbo')
backup=()
options=('!debug')
install=limbo.install
source=("git+https://github.com/Artifex-Technologies/Limbo.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/Limbo"
	printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$srcdir/Limbo/rust"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$srcdir/Limbo"
	export CGO_ENABLED=0
	go build -trimpath -ldflags "-s -w" -o limbo-go ./cmd/limbo
	cd rust
	export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
	cargo build --frozen --release -p limbo --bin limbo-rs
}

check() {
	cd "$srcdir/Limbo"
	# Unit tests only: the integration scripts need a hypervisor and root, and -short skips the real Wine run
	# (it makes a prefix, about a minute).
	go test -short ./...
	# the Rust daemon against the Go fixtures (testdata/parity), its properties and the fuzz bodies
	cd rust
	RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target cargo test --frozen -p limbo
}

package() {
	cd "$srcdir/Limbo"

	install -Dm755 rust/target/release/limbo-rs "$pkgdir/usr/bin/limbo"
	install -Dm755 limbo-go "$pkgdir/usr/lib/limbo/limbo-go"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 docs/QUARANTINE.md "$pkgdir/usr/share/doc/$pkgname/QUARANTINE.md"
	install -Dm644 docs/EVENTS.md "$pkgdir/usr/share/doc/$pkgname/EVENTS.md"
	install -Dm644 packaging/arch/limbo.service "$pkgdir/usr/lib/systemd/system/limbo.service"
	install -Dm644 packaging/arch/limbo.sysusers "$pkgdir/usr/lib/sysusers.d/limbo.conf"
	# The weekly full re-check of base images proven by a full hash (limbo image verify; docs/ARCHITECTURE.md
	# "Base images: hashed once, proven after"). Enabled here; it does nothing until a start has proven an image.
	# The drop-in lets Yggdrasil's game time hold it during a game, and runs it as usual where game time is absent.
	install -Dm644 packaging/arch/limbo-image-verify.service "$pkgdir/usr/lib/systemd/system/limbo-image-verify.service"
	install -Dm644 packaging/arch/limbo-image-verify.timer "$pkgdir/usr/lib/systemd/system/limbo-image-verify.timer"
	install -Dm644 packaging/arch/limbo-image-verify-gametime.conf \
		"$pkgdir/usr/lib/systemd/system/limbo-image-verify.service.d/gametime.conf"
	install -dm755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"
	ln -s ../limbo-image-verify.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/limbo-image-verify.timer"
	install -Dm644 examples/validation-profile.json "$pkgdir/usr/share/doc/$pkgname/examples/validation-profile.json"
	install -Dm644 examples/analysis-linux.json "$pkgdir/usr/share/doc/$pkgname/examples/analysis-linux.json"
	install -Dm644 examples/wine-profile.json "$pkgdir/usr/share/doc/$pkgname/examples/wine-profile.json"

	# Limbo's wine: programs that run `wine` from PATH land in Limbo's sandbox. Not on PATH by itself (nothing here
	# changes what /usr/bin/wine is); a person links it from a folder before /usr/bin:
	#   sudo ln -s /usr/lib/limbo/bin/wine /usr/local/bin/wine
	# Wine's other command names (the ones Wine installs as links to its loader) are links to the shim, which runs
	# the matching program inside the sandbox.
	install -Dm755 packaging/wine/wine "$pkgdir/usr/lib/limbo/bin/wine"
	for name in wineboot winecfg wineconsole winedbg winefile winemine winepath msiexec notepad regedit regsvr32; do
		ln -s wine "$pkgdir/usr/lib/limbo/bin/$name"
	done

	# Validation profiles define what a validation run may do, so the directory
	# is root-only writable (limbo serve refuses to load profiles from anywhere
	# else). Keys for those profiles live in a root-only directory.
	install -dm755 "$pkgdir/etc/limbo/validation"
	install -dm700 "$pkgdir/etc/limbo/keys"
}
